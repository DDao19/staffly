generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// Models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
}

model Employee {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email String @unique
  phone String

  street  String
  city    String
  state   String
  zipCode String

  jobTitle   String
  department String
  location   String

  status EmployeeStatus @default(PENDING)

  salary   Decimal  @db.Decimal(8, 2)
  hireDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
